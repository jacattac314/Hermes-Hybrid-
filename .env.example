OLLAMA_BASE_URL=http://localhost:11434
ROUTER_MODEL=hermes3:70b
LOCAL_WORKER_MODEL=llama3.2:3b

GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

GEMINI_MODEL=gemini/gemini-1.5-pro
GROQ_MODEL=groq/llama-3.1-70b-versatile

CHROMA_PERSIST_DIR=.chroma
MEMORY_COLLECTION=hermes_memory
MEMORY_TOP_K=5

ROUTER_TIMEOUT_S=30.0
DISPATCHER_TIMEOUT_S=60.0
